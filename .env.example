# Copy to .env and fill in. Never commit .env.

# LLM gateway: any OpenAI-compatible chat-completions API.
#   openrouter (default)  OPENROUTER_API_KEY
#   straitly              STRAITLY_API_KEY   (https://straitly.ai, https://api.straitly.ai/v1)
#   custom                LLM_BASE_URL + LLM_API_KEY + LLM_MODEL (+ SORT_VOTERS)
# LLM_GATEWAY is inferred from the keys you set; set it to make the choice explicit.
# LLM_GATEWAY=openrouter
OPENROUTER_API_KEY=
# STRAITLY_API_KEY=
# LLM_BASE_URL=https://your-gateway.example/v1
# LLM_API_KEY=
# Model ids are the gateway's own. Defaults: deepseek/deepseek-v4.1-flash (OpenRouter), deepseek/deepseek-v4-1-flash (Straitly); required for custom.
# LLM_MODEL=
# Extra models that vote on each sort batch (see src/v3/sort.ts). Defaults per gateway; "" disables voting.
# SORT_VOTERS=xiaomi/mimo-v2.6-flash,openai/gpt-6-luna-pro
# OpenRouter-only provider routing
LLM_PROVIDERS=Together,CoreWeave,Modal
# CLASSIFIER_MODEL defaults to LLM_MODEL

# X search (twitterapi.io)
TWITTERAPI_IO_KEY=

# Google search for Reddit threads (serper.dev; SerpAPI is the legacy v2 path)
SERPER_API_KEY=
SERPAPI_KEY=

# Residential proxy for Reddit comment fetches
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# Sign-in: Firebase project whose ID tokens are accepted (web config is public by design)
# FIREBASE_PROJECT_ID=

# Abuse and spend guards
# RATE_LIMIT_PER_HOUR=30
# DAILY_SPEND_CAP_USD=25
# ANON_PER_IP_PER_DAY=3
# CACHE_TTL_HOURS=6
