# Copy to .env and fill in. Never commit .env.

# LLM gateway: any OpenAI-compatible chat-completions API.
#   straitly (default)    STRAITLY_API_KEY   (https://straitly.ai, https://api.straitly.ai/v1)
#   openrouter            OPENROUTER_API_KEY
#   custom                LLM_BASE_URL + LLM_API_KEY + LLM_MODEL (+ SORT_VOTERS)
# LLM_GATEWAY is inferred from the keys you set (Straitly wins if both are set); set it to make the choice explicit.
# LLM_GATEWAY=straitly
STRAITLY_API_KEY=
# OPENROUTER_API_KEY=
# LLM_BASE_URL=https://your-gateway.example/v1
# LLM_API_KEY=
# Model ids are the gateway's own. Defaults: deepseek/deepseek-v4-1-flash (Straitly), deepseek/deepseek-v4.1-flash (OpenRouter); required for custom.
# LLM_MODEL=
# Extra models that vote on each sort batch (see src/v3/sort.ts). Defaults: xiaomi/mimo-v2.6-pro,gpt-6-luna (Straitly),
# xiaomi/mimo-v2.6-flash,openai/gpt-6-luna-pro (OpenRouter), none (custom). Empty disables the vote.
# SORT_VOTERS=
# Sort batches in flight (one LLM call per batch per model). Defaults: 60 Straitly, 160 OpenRouter, 20 custom.
# Straitly starter plan (64 requests in flight): set SORT_VOTERS= (empty) for full coverage, or SORT_CONCURRENCY=20 to keep the vote.
# SORT_CONCURRENCY=
# Price per 1,000 tokens used to meter a call when the gateway returns no usage.cost, so DAILY_SPEND_CAP_USD
# never treats LLM calls as free. Required for custom; Straitly and OpenRouter report cost and default to 0.002 as a safety net.
# LLM_USD_PER_1K_TOKENS=0.002
# OpenRouter-only provider routing
LLM_PROVIDERS=Together,CoreWeave,Modal
# CLASSIFIER_MODEL defaults to LLM_MODEL

# X search (twitterapi.io)
TWITTERAPI_IO_KEY=

# Google search for Reddit threads (serper.dev; SerpAPI is the legacy v2 path)
SERPER_API_KEY=
SERPAPI_KEY=

# Residential proxy for Reddit comment fetches
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# Sign-in: Firebase project whose ID tokens are accepted (web config is public by design)
# FIREBASE_PROJECT_ID=

# Abuse and spend guards
# RATE_LIMIT_PER_HOUR=30
# DAILY_SPEND_CAP_USD=25
# ANON_PER_IP_PER_DAY=3
# CACHE_TTL_HOURS=6
